{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "PowerShell(npm run *)",
      "Bash(npm install *)",
      "PowerShell(npm install *)",
      "Bash(npm ci)",
      "Bash(npx -y @anthropic-ai/skill-creator-mcp)",
      "Bash(npx -y @anthropic-ai/typescript-lsp-mcp)",
      "Bash(npx -y @anthropic-ai/claude-code-setup-mcp)",
      "Bash(claude mcp *)",
      "mcp__chrome-devtools"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint:fix"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qE 'globals\\.css|DESIGN\\.md' || exit 0; node \"${CLAUDE_PROJECT_DIR}/scripts/design-sync.mjs\" || true",
            "timeout": 15,
            "statusMessage": "Syncing design tokens"
          }
        ]
      }
    ]
  }
}
