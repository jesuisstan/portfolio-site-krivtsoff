{
  // Editor settings
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },

  // The built-in CSS validator does not understand Tailwind v4 syntax: it flags the at-rules
  // (@theme, @source, @custom-variant, @apply) as unknown, and `@import 'tailwindcss' source(none)`
  // as "semi-colon expected", since per the CSS spec only media/supports may follow an import.
  // Diagnostics come from the Tailwind CSS IntelliSense extension instead (see extensions.json).
  "css.validate": false,
  "css.lint.unknownAtRules": "ignore",

  // `cssConflict` flags any two classes in one string that touch the same CSS property — it does not
  // treat a variant as a separate condition. A theme-aware design system cannot avoid that: stating
  // "20% on paper, 40% on graphite" *requires* both `ring-destructive/20` and
  // `dark:ring-destructive/40`, and every shadcn recipe in src/components/ui is built that way, so the
  // rule fires on correct code and its only available fix would break a theme. Genuine same-property
  // duplicates are already resolved at runtime by tailwind-merge inside `cn()`, which is modifier-aware.
  "tailwindCSS.lint.cssConflict": "ignore",

  // Type-check in the editor with the same TypeScript the project pins (5.x). A newer bundled
  // TypeScript reports diagnostics `npm run typecheck` never sees, and TS 7 additionally breaks
  // next.config.ts — see .claude/agents/platform.md
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ESLint settings
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.run": "onType",
  "eslint.format.enable": true,

  // Prettier settings
  "prettier.enable": true,
  "prettier.requireConfig": true,

  // File associations
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // File watcher exclusions
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/out/**": true,
    "**/build/**": true
  }
}
